# ===================================================================
# CHAYBOOK BACKEND - TEMPLATE BIẾN MÔI TRƯỜNG (.env.example)
# Dùng để cấu hình file .env khi chạy Local hoặc nhập vào Render Dashboard
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE SQL SERVER (BẮT BUỘC)
# -------------------------------------------------------------------
# Chạy Cloud (Azure SQL / Render):
DB_URL=jdbc:sqlserver://chaybook-server.database.windows.net:1433;databaseName=ChayBook_Project;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# -------------------------------------------------------------------
# 2. SERVER PORT & JWT SECURITY (BẮT BUỘC)
# -------------------------------------------------------------------
PORT=8080
# Chuỗi bí mật ký JWT (tối thiểu 32 ký tự / 256 bits):
JWT_SECRET=c2VjdXJlX2p3dF9zZWNyZXRfa2V5X2Zvcl9jaGF5Ym9va19wcm9qZWN0XzIwMjY=

# -------------------------------------------------------------------
# 3. CORS DOMAINS (CẤU HÌNH DOMAIN FRONTEND TRUY CẬP)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://chay-book.vercel.app,http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (CHATBOT, VISION NHẬN DIỆN & PHÂN TÍCH VIDEO)
# -------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
VIDEO_GEMINI_MODEL=gemini-3.5-flash-lite
YOUTUBE_API_KEY=your_youtube_api_key_here

# -------------------------------------------------------------------
# 5. CLOUDINARY (LƯU TRỮ VÀ UPLOAD ẢNH / VIDEO)
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------
# 6. PAYOS PAYMENT (CỔNG THANH TOÁN GÓI PRO VIETQR)
# -------------------------------------------------------------------
PAYOS_CLIENT_ID=482af53d-0d15-4746-a056-01c2a597c954
PAYOS_API_KEY=8fb41e58-187e-4d65-b406-c6978aafe183
PAYOS_CHECKSUM_KEY=03afc2ed39e4598d78586c8ca803ba3dfe2c4df56c13c1b54413d20e7414242f
PAYOS_RETURN_URL=https://chay-book.vercel.app/payment/success
PAYOS_CANCEL_URL=https://chay-book.vercel.app/payment/cancel
PAYOS_PRO_PRICE=2000

# -------------------------------------------------------------------
# 7. EMAIL OTP - BREVO (TÙY CHỌN CHO ĐĂNG KÝ / QUÊN MẬT KHẨU)
# -------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=ChayBook

# -------------------------------------------------------------------
# 8. GROQ AI (TÙY CHỌN - KIỂM DUYỆT BÀI VIẾT TỰ ĐỘNG)
# -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# -------------------------------------------------------------------
# 9. GEOAPIFY (TÙY CHỌN - TÌM QUÁN ĂN CHAY GẦN ĐÂY)
# -------------------------------------------------------------------
GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=

# -------------------------------------------------------------------
# 10. SOCIAL LOGIN (TÙY CHỌN - GOOGLE / FACEBOOK OAUTH)
# -------------------------------------------------------------------
SOCIAL_LOGIN_ENABLED=false
SOCIAL_FRONTEND_URL=https://chay-book.vercel.app
SOCIAL_BACKEND_URL=https://chaybook.onrender.com
SOCIAL_SECURE_COOKIE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
